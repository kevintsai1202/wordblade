{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordblade.app/schema/synth.json",
  "title": "WordBlade 宣告式音效與配樂 spec（D27）",
  "description": "入口：音效用 #/$defs/sound，配樂用 #/$defs/music。所有物件的多餘欄位都會被丟掉。",
  "$defs": {
    "sound": {
      "description": "聲部清單；每個聲部是來源 → 濾波器 → 振幅包絡 → 選用效果。時間單位一律是秒，曲線的 t 從該聲部（每次重複）開頭算。",
      "type": "object",
      "required": [
        "length",
        "voices"
      ],
      "properties": {
        "length": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 10,
          "description": "總長度（秒）"
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "總音量，預設 0.8"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "description": "雜訊與殘響的亂數種子，預設 1"
        },
        "voices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "music": {
      "description": "可循環的配樂：速度、拍號（每小節幾拍，四分音符一拍）、小節數、和弦進行（每小節一個，不夠就從頭循環）與各聲部的音色和音符。長度＝bars×beatsPerBar×60÷bpm 秒，首尾無縫循環。",
      "type": "object",
      "required": [
        "bpm",
        "bars",
        "chords",
        "parts"
      ],
      "properties": {
        "bpm": {
          "type": "number",
          "minimum": 60,
          "maximum": 180
        },
        "beatsPerBar": {
          "enum": [
            2,
            3,
            4
          ],
          "description": "每小節幾拍，預設 4"
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "chords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-G](#|b)?(m|maj7|m7|7|dim|sus2|sus4)?$"
          },
          "description": "每小節一個和弦（例如 Am、F、C、G7、Dm7、Bbmaj7）"
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "總音量，預設 0.8"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/part"
          }
        }
      }
    },
    "freqCurve": {
      "description": "頻率（Hz）：一個數字（固定），或 1～16 個 {t, v} 點（t 秒、嚴格遞增；點之間以指數曲線過渡）",
      "anyOf": [
        {
          "type": "number",
          "minimum": 20,
          "maximum": 20000
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "t",
              "v"
            ],
            "properties": {
              "t": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "v": {
                "type": "number",
                "minimum": 20,
                "maximum": 20000
              }
            }
          }
        }
      ]
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "type",
            "wave"
          ],
          "properties": {
            "type": {
              "enum": [
                "osc"
              ]
            },
            "wave": {
              "enum": [
                "sine",
                "square",
                "sawtooth",
                "triangle"
              ]
            },
            "freq": {
              "$ref": "#/$defs/freqCurve",
              "description": "音效必填；配樂由音符決定音高，可省略"
            },
            "detune": {
              "type": "number",
              "minimum": -1200,
              "maximum": 1200,
              "description": "音分"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "color"
          ],
          "properties": {
            "type": {
              "enum": [
                "noise"
              ]
            },
            "color": {
              "enum": [
                "white",
                "pink"
              ]
            }
          }
        }
      ]
    },
    "filter": {
      "type": "object",
      "required": [
        "type",
        "cutoff"
      ],
      "properties": {
        "type": {
          "enum": [
            "lowpass",
            "highpass",
            "bandpass",
            "notch"
          ]
        },
        "cutoff": {
          "$ref": "#/$defs/freqCurve"
        },
        "q": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 30,
          "description": "預設 1"
        }
      }
    },
    "env": {
      "type": "object",
      "required": [
        "attack",
        "decay",
        "sustain",
        "release"
      ],
      "properties": {
        "attack": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "decay": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "sustain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "release": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "delay": {
          "type": "object",
          "required": [
            "time",
            "feedback",
            "mix"
          ],
          "properties": {
            "time": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1
            },
            "feedback": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.9
            },
            "mix": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "reverb": {
          "type": "object",
          "required": [
            "decay",
            "mix"
          ],
          "properties": {
            "decay": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 6
            },
            "mix": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "distortion": {
          "type": "object",
          "required": [
            "amount"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "voice": {
      "description": "音色：來源 → 濾波器（選用）→ 振幅包絡 → 效果（選用）",
      "type": "object",
      "required": [
        "source",
        "env"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "filter": {
          "$ref": "#/$defs/filter"
        },
        "env": {
          "$ref": "#/$defs/env"
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "預設 1"
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "am": {
          "description": "隨機振幅調變：每 1/rate 秒換一個隨機音量（1−depth～1，平滑過渡），做紙張翻動、沙沙聲的顆粒感",
          "type": "object",
          "required": [
            "rate",
            "depth"
          ],
          "properties": {
            "rate": {
              "type": "number",
              "minimum": 1,
              "maximum": 200,
              "description": "每秒換幾次"
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "起伏深度"
            }
          }
        }
      }
    },
    "event": {
      "description": "音效的一個聲部：音色＋什麼時候響（start）、按住多久（dur，之後進入 release）、重複幾次（打字、連續點擊）",
      "type": "object",
      "required": [
        "source",
        "env"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "filter": {
          "$ref": "#/$defs/filter"
        },
        "env": {
          "$ref": "#/$defs/env"
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "am": {
          "description": "隨機振幅調變：每 1/rate 秒換一個隨機音量（1−depth～1，平滑過渡），做紙張翻動、沙沙聲的顆粒感",
          "type": "object",
          "required": [
            "rate",
            "depth"
          ],
          "properties": {
            "rate": {
              "type": "number",
              "minimum": 1,
              "maximum": 200,
              "description": "每秒換幾次"
            },
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "起伏深度"
            }
          }
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "開始時間（秒），預設 0"
        },
        "dur": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 10,
          "description": "按住多久（秒），預設到總長度減 release"
        },
        "repeat": {
          "type": "object",
          "required": [
            "count",
            "every"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "every": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 2
            }
          }
        }
      }
    },
    "part": {
      "description": "一個聲部；drums 用內建鼓組（不用 voice），其他聲部要有 voice",
      "type": "object",
      "required": [
        "role",
        "notes"
      ],
      "properties": {
        "role": {
          "enum": [
            "bass",
            "pad",
            "arp",
            "lead",
            "drums"
          ]
        },
        "voice": {
          "$ref": "#/$defs/voice"
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "預設 1"
        },
        "loopBars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "音符表涵蓋幾小節、之後重複；預設＝整首的 bars"
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/note"
          }
        }
      }
    },
    "note": {
      "description": "一個音符：at、len 以拍為單位（從這個聲部的音符表開頭算）。音高三選一：pitch（MIDI 編號）、chord（該小節和弦的第幾個音：0 根音、1 三音、2 五音、3 七音或高八度根音，配 octave）、drum（鼓聲部）",
      "type": "object",
      "required": [
        "at",
        "len"
      ],
      "properties": {
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 128
        },
        "len": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 32
        },
        "pitch": {
          "type": "integer",
          "minimum": 24,
          "maximum": 96
        },
        "chord": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "octave": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "description": "chord 用；預設 bass 2、pad 與 arp 4、lead 5"
        },
        "drum": {
          "enum": [
            "kick",
            "snare",
            "hat",
            "openhat",
            "clap"
          ]
        },
        "vel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "力度，預設 0.8"
        }
      }
    }
  }
}
